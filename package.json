{
  "name": "flights",
  "version": "0.0.1",
  "description": "flights scraper",
  "main": "src/crawl.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akdombrowski/flights.git"
  },
  "keywords": [
    "apify",
    "nfl",
    "draft",
    "2022",
    "prospects",
    "players",
    "college",
    "ncaa"
  ],
  "author": "Anthony Dombrowski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/akdombrowski/flights/issues"
  },
  "homepage": "https://github.com/akdombrowski/flights#readme",
  "type": "module",
  "dependencies": {
    "@crawlee/linkedom": "^3.12.2",
    "@crawlee/utils": "^3.12.2",
    "apify": "^3.3.0",
    "cheerio": "^1.0.0",
    "crawlee": "^3.12.2",
    "got-scraping": "^4.0.8",
    "puppeteer": "^24.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "apify-cli": "^0.21.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageExtensions": {
    "@crawlee/linkedom@*": {
      "dependencies": [
        {
          "@crawlee/utils": "*"
        },
        {
          "cheerio": "*"
        }
      ]
    }
  },
  "packageManager": "yarn@4.6.0"
}
